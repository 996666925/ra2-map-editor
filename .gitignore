# Cargo build output and machine-specific configuration
/target/
/dist/
/.cargo/

# Private development documents (kept locally), except public guides
/docs/*
!/docs/user-guide.md
!/docs/cli.md
!/docs/development.md
/ARCHITECTURE.md

# Local editor settings
/.idea/
/.vscode/
/.vs/

# Local verification, playtest and recovery output
*.log
/playtest/
/recovery/
*.yrrec
*.yr-editor-*.bak

# Temporary files and operating system metadata
__pycache__/
*.pyc
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# npm SDK build and local dependencies
/crates/*/node_modules/
/crates/*/*.tgz

/node_modules/
